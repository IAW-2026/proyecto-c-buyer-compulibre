# Clerk Keys (Obtenlas en Dashboard > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk URLs (Rutas de tu aplicación)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/products
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/products

# Control Plane (superadmin) y Analytics Dashboard (Token para la API M2M administrativa)
ANALYTICS_API_KEY=
SUPERADMIN_API_KEY=

# API Key por servicio
SELLER_API_KEY= 
SHIPPING_API_KEY= 
PAYMENTS_API_KEY= 
BUYER_API_KEY=

#URL de Deploys
SELLER_APP_API_URL=
PAYMENTS_APP_API_URL=
SHIPPING_APP_API_URL=

# URL de la Shipping App (para el botón "Seguir envío" en el detalle de orden)
NEXT_PUBLIC_SHIPPING_APP_URL=

# Database (Neon / PostgreSQL)
# URL con pooler para la app (runtime)
DATABASE_URL=

# URL directa sin pooler para migraciones (prisma migrate)
DIRECT_URL=
